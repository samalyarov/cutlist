# Python environment
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.ipynb_checkpoints/

# Secrets and local overrides
.env
.env.*
!.env.example
*.local.yaml

# Source videos, per-video indexes, run workdirs, rendered clips.
# Large, regenerable, or not ours to redistribute.
input/
cache/
work/
output/
references/

# Presets are personal -- captions, pacing, whatever someone is making. Only
# the sample is tracked, as the thing to copy when writing your own.
presets/*
!presets/sample_preset.yaml

# Media, anywhere in the tree. Drop a `!path/to/clip.mp4` line below if a
# specific clip ever needs to be tracked as a test fixture.
*.mp4
*.mkv
*.avi
*.mov
*.webm
*.m4v
*.gif
*.srt
*.ass
*.vtt

# Generated analysis artifacts
*.sqlite
# WAL sidecars: present for as long as any connection is open, which is the
# whole time `cutlist review` runs -- exactly when someone reaches for
# `git add -A`. They hold rating data not yet folded into the .sqlite file.
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.db
*.npy
*.npz
thumbs/
sheets/

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# LLM
.claude/
.superpowers/

# Specs and implementation plans. Development artifacts kept locally rather
# than published. Earlier commits still contain them; this stops new ones
# being tracked, and deliberately does not rewrite that history.
docs/